cat > .gitignore <<'EOF'
# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/
test-results/

# Vite / React caches
.vite/
**/.vite/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
EOF

# Misc files
check.sh
accounts.txt