# AccountService environment variables
NODE_ENV=development
PORT=3002

# PostgreSQL – account database
DB_HOST=localhost
DB_PORT=5433
DB_NAME=account
DB_USER=account_user
DB_PASS=account_pass
DB_SSL=false

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=account-service
KAFKA_GROUP_ID=account-service-group

# Internal service-to-service secret
INTERNAL_SECRET=internal-secret

# AdminService URL (kept for reference — notifications now flow via Kafka)
ADMIN_SERVICE_URL=http://localhost:3003

# Frontend base URL (used in notification email links)
APP_BASE_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173
