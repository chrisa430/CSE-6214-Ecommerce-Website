NODE_ENV=development
PORT=3005
DB_HOST=localhost
DB_PORT=5436
DB_NAME=order
DB_USER=order_user
DB_PASS=order_pass
DB_SSL=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-service
KAFKA_GROUP_ID=order-service-group
INTERNAL_SECRET=internal-secret
CORS_ORIGIN=http://localhost:5173

# Cross-DB connections (use Docker service names when running in containers,
# localhost + host-mapped ports when running via npm run dev on the host)
CART_DB_HOST=postgres-shopping-cart
CART_DB_PORT=5432
CART_DB_NAME=shopping_cart
CART_DB_USER=shopping_cart_user
CART_DB_PASS=shopping_cart_pass
INVENTORY_DB_HOST=postgres-inventory
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASS=inventory_pass
