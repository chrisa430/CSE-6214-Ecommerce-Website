{
  "name": "admin-service",
  "version": "1.0.0",
  "description": "Admin management microservice for SportVault — handles account approvals and notification dispatch",
  "main": "dist/index.js",
  "scripts": {
    "dev":   "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors":               "^2.8.5",
    "dotenv":             "^16.4.5",
    "express":            "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet":             "^7.1.0",
    "kafkajs":            "^2.2.4",
    "nodemailer":         "^6.9.14",
    "pg":                 "^8.12.0",
    "uuid":               "^10.0.0",
    "winston":            "^3.13.0"
  },
  "devDependencies": {
    "@types/cors":        "^2.8.17",
    "@types/express":     "^4.17.21",
    "@types/node":        "^20.14.10",
    "@types/nodemailer":  "^6.4.15",
    "@types/pg":          "^8.11.6",
    "@types/uuid":        "^10.0.0",
    "ts-node-dev":        "^2.0.0",
    "typescript":         "^5.5.3"
  }
}
