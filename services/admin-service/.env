# AdminService environment variables
NODE_ENV=development
PORT=3003

# PostgreSQL – admin database (notifications, decisions, audit)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=admin
DB_USER=admin_user
DB_PASS=admin_pass
DB_SSL=false

# PostgreSQL – account database (cross-service reads for admin account list & status updates)
ACCOUNT_DB_HOST=localhost
ACCOUNT_DB_PORT=5433
ACCOUNT_DB_NAME=account
ACCOUNT_DB_USER=account_user
ACCOUNT_DB_PASS=account_pass

# PostgreSQL – inventory database (cross-service reads/writes for product management)
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5437
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASS=inventory_pass

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=admin-service
KAFKA_GROUP_ID=admin-service-group

# Internal service-to-service secret (must match AccountService)
INTERNAL_SECRET=internal-secret

# Frontend base URL (used in notification email links)
APP_BASE_URL=http://localhost:5173

# SMTP settings (set to real values in production; dev uses Ethereal/stub)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sportvault.local

# Notification outbox poll interval in milliseconds (default 30 s)
OUTBOX_POLL_MS=30000

# CORS
CORS_ORIGIN=http://localhost:5173
