# OrderService — local development environment
# Docker containers read from docker-compose.yml environment blocks instead.

NODE_ENV=development
PORT=3005

# Own database (host-mapped)
DB_HOST=localhost
DB_PORT=5436
DB_NAME=order
DB_USER=order_user
DB_PASS=order_pass
DB_SSL=false

# JWT — must match authn-authz-service
JWT_ACCESS_SECRET=sv_access_secret_min32chars_changeinprod!!

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-service
KAFKA_GROUP_ID=order-service-group

# Security
INTERNAL_SECRET=internal-secret
CORS_ORIGIN=http://localhost:5173
ORDER_AGE=60
APP_BASE_URL=http://localhost:5173

# Cross-DB connections — use localhost + host-mapped ports for npm run dev
CART_DB_HOST=localhost
CART_DB_PORT=5435
CART_DB_NAME=shopping_cart
CART_DB_USER=shopping_cart_user
CART_DB_PASS=shopping_cart_pass

INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5437
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASS=inventory_pass

ADMIN_DB_HOST=localhost
ADMIN_DB_PORT=5434
ADMIN_DB_NAME=admin
ADMIN_DB_USER=admin_user
ADMIN_DB_PASS=admin_pass

ACCOUNT_DB_HOST=localhost
ACCOUNT_DB_PORT=5433
ACCOUNT_DB_NAME=account
ACCOUNT_DB_USER=account_user
ACCOUNT_DB_PASS=account_pass
