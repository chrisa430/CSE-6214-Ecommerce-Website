# AuthnAuthzService environment variables

NODE_ENV=development
PORT=3001

# PostgreSQL – authn_authz database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authn_authz
DB_USER=authn_user
DB_PASS=authn_pass
DB_SSL=false

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=authn-authz-service
KAFKA_GROUP_ID=authn-authz-group

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS_LONG
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS_LONG
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AccountService internal URL (for credential lookup via HTTP)
ACCOUNT_SERVICE_URL=http://localhost:3002

# CORS
CORS_ORIGIN=http://localhost:5173
