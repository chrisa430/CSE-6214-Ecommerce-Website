# AuthnAuthzService — local development environment
# When running via npm run dev (not Docker), this file is loaded by dotenv.
# Docker containers read from docker-compose.yml environment blocks instead.

NODE_ENV=development
PORT=3001

# PostgreSQL – authn_authz database (host-mapped port for local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authn_authz
DB_USER=authn_user
DB_PASS=authn_pass
DB_SSL=false

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=authn-authz-service
KAFKA_GROUP_ID=authn-authz-group

# JWT — must match the values in root .env (used by docker-compose) and all
# other services that verify tokens (order, cart, inventory).
JWT_ACCESS_SECRET=sv_access_secret_min32chars_changeinprod!!
JWT_REFRESH_SECRET=sv_refresh_secret_min32chars_changeinprod!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AccountService internal URL (for credential lookup via HTTP)
ACCOUNT_SERVICE_URL=http://localhost:3002

# Security
INTERNAL_SECRET=internal-secret
CORS_ORIGIN=http://localhost:5173
