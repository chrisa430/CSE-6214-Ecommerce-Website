{
  "name": "sportvault",
  "version": "4.0.0",
  "private": true,
  "description": "SportVault – Sprint 4: Authentication, Registration & Microservices",
  "workspaces": [
    "apps/web",
    "services/authn-authz-service",
    "services/account-service"
  ],
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "install:all": "npm install && cd apps/web && npm install && cd ../../services/authn-authz-service && npm install && cd ../account-service && npm install",
    "dev:web": "cd apps/web && npm run dev",
    "dev:authn": "cd services/authn-authz-service && npm run dev",
    "dev:account": "cd services/account-service && npm run dev"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
